# __BOARD_NAME__ — per-board Kconfig overrides, loaded on top of the root
# sdkconfig.defaults. Uncomment the features the hardware has.
CONFIG_KASE_DEVICE_ROLE_KEYBOARD=y
CONFIG_KASE_NO_DISPLAY=y            # remove this line and pick a backend in board.h to have a screen
# CONFIG_KASE_KBD_WIRELESS=y        # nRF24 relay to the dongle (needs BOARD_NRF_*)
# CONFIG_KASE_SPLIT_MASTER=y        # this is the master half of a split
# CONFIG_KASE_VEILLE=y              # light/deep sleep, single sleep task
# CONFIG_PM_ENABLE=y                # DFS 160/40 MHz (with KASE_VEILLE)
# CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
# CONFIG_KASE_BATT_SENSE=y          # ADC gauge (needs BOARD_VBAT_SENSE_GPIO)
# CONFIG_KASE_DISPLAY_MEMLCD=y      # Sharp memory-LCD (needs BOARD_LCD_CS_GPIO)
# CONFIG_KASE_LINK_WIRE=y           # TRRS UART link (needs BOARD_LINK_*)
# CONFIG_KASE_HAS_BLE=n             # BLE HID (V2 only today)
