CONFIG_KASE_DEVICE_ROLE_KEYBOARD=y
CONFIG_KASE_SPLIT_MASTER=y

# Pas de BLE : le budget d'alimentation l'interdit (HT7833, pics radio hors
# budget). La config et les mises à jour passent par USB.
# KASE_HAS_BLE est un bool SANS prompt (main/Kconfig.projbuild) : il n'est PAS
# surchargeable ici, le gate réel est le `default n if KASE_SPLIT_MASTER` dans
# le Kconfig. CONFIG_BT_ENABLED=n coupe la pile Bluedroid elle-même (héritée de
# sdkconfig.defaults) — c'est ce qui a un effet.
CONFIG_BT_ENABLED=n

# La gauche est le maître (moteur keymap + trackpad) : c'est la moitié dont les
# logs comptent le plus. GPIO43/44 sont le connecteur de prog dédié sur
# Niphargus, jamais la matrice (cf. boards/niphar_left/board.h) — le
# CONFIG_ESP_CONSOLE_NONE de la base ne vise que la matrice du V2 et n'a pas
# lieu de s'appliquer ici.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# Module réellement posé : ESP32-S3-WROOM-1 N16R8 (16 MB flash / 8 MB PSRAM),
# constaté à l'esptool au bring-up du 2026-09-01.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Bring-up 2026-09-01 : verifier que la nRF24 repond sur le SPI.
# DESACTIVE le 2026-09-05 : depuis que KASE_KBD_WIRELESS est actif, kbd_relay_tx
# initialise deja la radio et logue son propre "probe csn=". Le laisser actif
# double l'init du bus SPI ("spi_bus_initialize: SPI bus already initialized")
# et brouille le diagnostic. L'option reste dans l'arbre pour un futur bring-up
# de la moitie droite, qui n'a pas encore de consommateur RF.
# Une radio, un maitre : rf_probe reinitialiserait la puce avec SON canal et
# SON adresse par-dessus celle de kbd_relay (la gauche a ecoute le canal du
# dongle trois fois pour ca, en silence).
# CONFIG_KASE_NRF_PROBE=y

# Relais vers le dongle : la radio de la gauche appartient a kbd_relay_tx, seul
# a l'initialiser (rf_claim_chip le verifie).
CONFIG_KASE_KBD_WIRELESS=y
# Fusion au dongle (design 2026-09-12, en service depuis le 2026-09-13) : la
# gauche emet sa demi-matrice BRUTE, le dongle fusionne et tape. C'est le mode
# nominal du clavier ; le chemin pre-fusion (HALF_LINK_RX) est retire.
CONFIG_KASE_DONGLE_FUSION=y


# Banc du 2026-09-05 : l'alimentation batterie ne fonctionne pas, donc
# debrancher l'USB pour faire basculer le routage n'est pas possible. On force
# le HID sur la radio, USB branche, pour eprouver le lien vers le dongle.
# A RETIRER une fois l'alimentation batterie reparee : tant que c'est actif, la
# moitie gauche ne tape plus par son propre USB.
# CONFIG_KASE_RF_FORCE_ROUTE=y   (sans relais, le forcage n'a plus d'objet)

# B7 — veille hybride. Léger (light sleep, ~240 µA, réveil ~1 ms, état
# conservé) tenu plusieurs heures parce qu'il ne coûte quasiment rien, puis
# profond (deep sleep, ~8 µA, réveil EXT1) au-delà, au prix d'un redémarrage.
# ⚠ Radio éteinte dès l'étage léger : écouter coûte 13,1 mA. Une moitié
# endormie n'entend pas l'autre, chacune se réveille sur SA matrice.
CONFIG_KASE_VEILLE=y
# carte ne repart pas, c'est le light sleep et rien d'autre. À rabaisser à 30 s
# ensuite pour éprouver EXT1.
# (light-sleep threshold: see the 5 s block at the end of this file)
CONFIG_KASE_VEILLE_PROFONDE_S=14400

# B2 — lien filaire TRRS. Le 5 V est mort par défaut et ne se ferme qu'après
# sonde + ACK sur l'UART1. Une moitié en charge reste éveillée.
CONFIG_KASE_LINK_WIRE=y

# Jauge batterie : ADC2 sur VBAT_SENSE (GPIO13), remontee au dongle par STATUS.
CONFIG_KASE_BATT_SENSE=y

# Ecran Sharp memory-LCD (portrait 68x160) sur le SPI partage avec le nRF24.
CONFIG_KASE_DISPLAY_MEMLCD=y

# Frequence dynamique (esp_pm, DFS) — 2026-09-16. Le cout du clavier est
# l'EVEIL OISIF, pas la veille : coeurs oisifs 27,6 mA a 160 MHz contre
# 13,2 mA a 40 MHz (ESP32-S3 datasheet v2.2, table 5-9, p. 67). esp_pm tient
# la frequence MAX tant qu'une tache tourne, MIN (XTAL, PLL coupee) quand tout
# dort. La console repasse sur XTAL toute seule ; SPI/gptimer/ADC prennent
# leurs verrous ; l'UART du lien est sur XTAL (link_uart.c) ; l'USB tient un
# verrou APB tant qu'un hote est monte (power/pm_dfs.c). Pas de tickless ici.
CONFIG_PM_ENABLE=y
CONFIG_PM_DFS_INIT_AUTO=y
# La console secondaire USB-Serial/JTAG garde la PLL allumee et n'a aucun
# lecteur sur une moitie (console = UART0 au connecteur de prog).
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# Dormir ENTRE les touches (2026-09-16) : light sleep automatique d'ESP-IDF
# (tickless idle) des que tout dort >= 3 ticks et qu'aucun verrou n'est tenu.
# Balayage a interruption au repos, cadences des taches a 100 ms, LVGL a 200 ms :
# il reste de la place pour dormir entre deux frappes. Broches radio et ecran
# ont leur configuration de sommeil (CE bas, CSN haut, CS/SCK/MOSI bas).
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y

# Power down VDD_SPI during light sleep (measured 2026-09-25, ammeter on the
# battery). The N16R8 carries 8 MB of octal PSRAM in the package that this
# firmware never uses (CONFIG_SPIRAM off) — but VDD_SPI stays powered in light
# sleep, all IOs are isolated, the PSRAM CS floats low and the chip believes it
# is selected: "a large current leakage" (IDF Kconfig help of
# ESP_SLEEP_PSRAM_LEAKAGE_WORKAROUND, which `depends on SPIRAM` and so cannot
# be selected here). Cutting VDD_SPI is the documented way out when !SPIRAM.
# Left half: 7.5 mA -> 5.0 mA in light sleep (0.2 mA in deep sleep, the board's
# floor). Cost: flash re-powered on every wake, ~1-3 ms more before the capture.
CONFIG_ESP_SLEEP_POWER_DOWN_FLASH=y

# Light sleep after 5 s of inactivity (was 15 s, 2026-09-25). Measured on the
# left half: awake idle 16-24 mA against ~1.6 mA asleep — every second of a
# pause spent awake costs ~12x what it would asleep, and the 5-15 s pauses
# (reading, thinking) are the most common while working. Safe only since
# VEILLE_VETO_TOUCHE: a key held with nothing else happening no longer sends
# the half to sleep key down. The CRITICAL battery level already used 5 s.
CONFIG_KASE_VEILLE_LEGERE_S=5
