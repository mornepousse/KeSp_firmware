CONFIG_KASE_DEVICE_ROLE_NIPHAR_SLAVE=y

# Pas de BLE : le budget d'alimentation l'interdit (HT7833, pics radio hors
# budget). La config et les mises à jour passent par USB.
# KASE_HAS_BLE est un bool SANS prompt (main/Kconfig.projbuild) : il n'est PAS
# surchargeable ici, le gate réel est le `default n if KASE_DEVICE_ROLE_NIPHAR_SLAVE`
# dans le Kconfig. CONFIG_BT_ENABLED=n coupe la pile Bluedroid elle-même
# (héritée de sdkconfig.defaults) — c'est ce qui a un effet.
CONFIG_BT_ENABLED=n

# La droite n'a pas d'USB utile en production (charge seulement, pas de HID) :
# une console au connecteur de prog est précieuse au bring-up.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# Module réellement posé : ESP32-S3-WROOM-1 N16R8 (16 MB flash / 8 MB PSRAM).
# Constaté à l'esptool sur la moitié GAUCHE au bring-up du 2026-09-01 ; la
# droite n'a pas encore été lue, on suppose le même BOM.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Bring-up 2026-09-05 : la droite scanne desormais sa matrice, et chaque
# changement sort en clair sur la console du connecteur de prog. C'est le seul
# moyen de verifier la table de brochage DROITE contre le contrat materiel —
# elle differe de la gauche par des permutations de routage, et aucune
# compilation ne detecte une inversion (risque R3 de la spec).
# A retirer une fois le brochage valide : trop lent pour de la frappe reelle.
# RETIRE le 2026-09-06 : le brochage est valide au banc (les 11 broches
# correspondent a la table DROITE du contrat), c'etait sa seule raison d'etre.
# Un ESP_LOGW par changement de touche depuis le callback de scan est trop lent
# pour de la frappe reelle, et le CLAUDE.md l'interdit. Reactivable si une
# future carte demande la meme verification.
# CONFIG_KASE_MATRIX_LOG_CONSOLE=y

# Bring-up 2026-09-06 : la nRF24 de la droite repond-elle ? Le probe ne fait que
# lire des registres et une init PRX — quelques mA, compatible avec
# l'alimentation par le LDO du FTDI, convertisseur 3,3 V dessoude.
# A retirer une fois B3 ecrit : kbd_relay_tx initialisera alors la radio.
# Probe coupe : half_link prend la radio desormais, et les deux se
# disputeraient le bus SPI. Le reactiver ponctuellement pour un diagnostic.
# CONFIG_KASE_NRF_PROBE=y

# B3 : la droite emet sa demi-matrice vers la gauche.
CONFIG_KASE_HALF_LINK_TX=y
# Fusion au dongle (2026-09-13) : la droite emet sa demi-matrice brute au dongle
# (KaSe.01), repli vers la gauche si le dongle se tait (half_tx_target_step).
CONFIG_KASE_DONGLE_FUSION=y

# B7 — veille hybride. Léger (light sleep, ~240 µA, réveil ~1 ms, état
# conservé) tenu plusieurs heures parce qu'il ne coûte quasiment rien, puis
# profond (deep sleep, ~8 µA, réveil EXT1) au-delà, au prix d'un redémarrage.
# ⚠ Radio éteinte dès l'étage léger : écouter coûte 13,1 mA. Une moitié
# endormie n'entend pas l'autre, chacune se réveille sur SA matrice.
CONFIG_KASE_VEILLE=y

# B2 — lien filaire TRRS. Le 5 V est mort par défaut et ne se ferme qu'après
# sonde + ACK sur l'UART1. Une moitié en charge reste éveillée.
CONFIG_KASE_LINK_WIRE=y

# Jauge batterie : ADC2 sur VBAT_SENSE (GPIO13), remontee au dongle par STATUS.
CONFIG_KASE_BATT_SENSE=y

# Ecran Sharp memory-LCD (portrait 68x160) sur le SPI partage avec le nRF24.
CONFIG_KASE_DISPLAY_MEMLCD=y

# Frequence dynamique (esp_pm, DFS) — 2026-09-16. Le cout du clavier est
# l'EVEIL OISIF, pas la veille : coeurs oisifs 27,6 mA a 160 MHz contre
# 13,2 mA a 40 MHz (ESP32-S3 datasheet v2.2, table 5-9, p. 67). esp_pm tient
# la frequence MAX tant qu'une tache tourne, MIN (XTAL, PLL coupee) quand tout
# dort. La console repasse sur XTAL toute seule ; SPI/gptimer/ADC prennent
# leurs verrous ; l'UART du lien est sur XTAL (link_uart.c) ; l'USB tient un
# verrou APB tant qu'un hote est monte (power/pm_dfs.c). Pas de tickless ici.
CONFIG_PM_ENABLE=y
CONFIG_PM_DFS_INIT_AUTO=y
# La console secondaire USB-Serial/JTAG garde la PLL allumee et n'a aucun
# lecteur sur une moitie (console = UART0 au connecteur de prog).
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# Dormir ENTRE les touches (2026-09-16) : light sleep automatique d'ESP-IDF
# (tickless idle) des que tout dort >= 3 ticks et qu'aucun verrou n'est tenu.
# Balayage a interruption au repos, cadences des taches a 100 ms, LVGL a 200 ms :
# il reste de la place pour dormir entre deux frappes. Broches radio et ecran
# ont leur configuration de sommeil (CE bas, CSN haut, CS/SCK/MOSI bas).
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
